{
  "name": "voice-ai-patient-registration",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "sync": "bun scripts/ensure-deps.ts && bunx convex dev --once",
    "sync:build": "bun run sync && bun run build",
    "logs": "bunx convex logs",
    "logs:fetch": "bun run --bun scripts/logs.ts",
    "test": "bun scripts/ensure-deps.ts && bun run --bun scripts/test.ts",
    "test:auth": "bun run --bun scripts/auth.ts",
    "test:unit": "bun test --parallel scripts/",
    "test:design-review": "bun test scripts/design-review-specimen.test.ts",
    "test:viktor-spaces-access": "bun test scripts/viktor-spaces-access.test.tsx && bun test scripts/convex-auth-contract.test.ts && bun test scripts/membership-recheck.test.ts && bun test scripts/viktor-auth-redirect.test.ts && bun test scripts/viktor-embed-bridge.test.ts",
    "test:modules": "bun test scripts/modules.test.ts",
    "test:phi-redaction": "bun test scripts/phi-console-redaction.test.ts",
    "test:phi-functions": "bun test scripts/phi-authenticated-functions.test.ts",
    "check:phi-functions": "bun run --bun scripts/check-phi-authenticated-functions.ts",
    "generate:phi-statics": "bun run --bun scripts/generate-phi-console-statics.ts",
    "design:review": "bun scripts/ensure-deps.ts && bun run --bun scripts/design-review.ts",
    "env:get": "bunx convex env get",
    "env:list": "bunx convex env list",
    "test:validation": "bun test tests/validation.test.ts",
    "test:api": "bun test tests/api.e2e.test.ts",
    "provision:vapi": "bun voice-agent/provision.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@convex-dev/auth": "^0.0.94",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@number-flow/react": "^0.6.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-router": "^8.3.0",
    "recharts": "^2.15.2",
    "roughjs": "^4.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.3.10",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "0.28.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@~5.9.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "@babel/core": "7.29.7",
    "browserslist": "4.28.7",
    "esbuild": "0.28.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "picomatch": "4.0.5"
  }
}
