# --- Database ---------------------------------------------------------------
# PostgreSQL in production (Railway injects this automatically).
# Falls back to a local SQLite file when unset.
DATABASE_URL=postgresql://user:password@host:5432/patients

# --- Voice agent (Vapi) -------------------------------------------------------
# Shared secret Vapi sends in the `x-vapi-secret` header on every webhook.
# The API rejects webhook calls without it when set.
VAPI_WEBHOOK_SECRET=change-me
# Only needed by scripts/provision_vapi.py (never by the running API).
VAPI_API_KEY=
# Public base URL of this API — used to point Vapi tools at /vapi/webhook.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- App ----------------------------------------------------------------------
CLINIC_NAME=CareCloud Family Medicine
CLINIC_TIMEZONE=America/New_York
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
